{
  "name": "pluffy-studio",
  "productName": "Pluffy Studio",
  "version": "0.1.0",
  "description": "Pluffy Studio: a GUI skin over the Pluffy CLI (menu, terminal, VS Code, chat).",
  "main": "main.js",
  "author": "Mizumi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle-repo.js",
    "bundle:local": "node scripts/bundle-repo.js --local",
    "dist": "node scripts/bundle-repo.js && electron-builder"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.pluffy.studio",
    "productName": "Pluffy Studio",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pluffy",
        "to": "pluffy"
      }
    ],
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
