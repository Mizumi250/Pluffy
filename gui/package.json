{
  "name": "pluffy-studio",
  "productName": "Pluffy Studio",
  "version": "0.1.0",
  "description": "Pluffy Studio: a GUI skin over the Pluffy CLI (menu, terminal, tatemono editor, chat).",
  "main": "main.js",
  "author": "Mizumi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build",
    "build": "node scripts/build-renderer.js",
    "bundle": "node scripts/bundle-repo.js",
    "bundle:local": "node scripts/bundle-repo.js --local",
    "dist": "npm run build && node scripts/bundle-repo.js && electron-builder"
  },
  "dependencies": {
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@shikijs/monaco": "^4.6.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.79.0",
    "monaco-editor": "^0.58.0",
    "shiki": "^4.6.0"
  },
  "build": {
    "appId": "app.pluffy.studio",
    "productName": "Pluffy Studio",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pluffy",
        "to": "pluffy"
      }
    ],
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
