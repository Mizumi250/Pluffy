{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluff",
  "version": "1.0.0",
  "identifier": "com.pluff.engine",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../react-vite/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pluff",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
