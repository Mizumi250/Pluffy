{
  "name": "arkzen-expo-engine",
  "version": "1.0.0",
  "description": "Arkzen Engine — Expo stack (v9.5). Same tatemono DSL, Expo Go native output.",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "sync:shared": "tsx arkzen/sync.ts",
    "arkzen": "tsx watch arkzen.ts",
    "dev": "npm run sync:shared && npm run arkzen",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-font": "~13.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "nativewind": "^4.1.23",
    "react": "18.3.0",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.3.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-gesture-handler": "~2.20.2",
    "zustand": "^5.0.12",
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
