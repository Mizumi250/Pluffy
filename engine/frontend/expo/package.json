{
  "name": "arkzen-expo-engine",
  "version": "1.0.0",
  "description": "Arkzen Engine — Expo stack (v53). Same tatemono DSL, Expo Go native output.",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "sync:shared": "tsx arkzen/sync.ts",
    "arkzen": "tsx watch arkzen.ts",
    "dev": "npm run sync:shared && npm run arkzen",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios"
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-font": "~13.3.0",
    "expo-splash-screen": "~0.30.10",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.1.7",
    "expo-image": "~2.4.1",
    "expo-haptics": "~14.1.4",
    "expo-web-browser": "~14.2.0",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-gesture-handler": "~2.24.0",
    "lottie-react-native": "7.2.2",
    "zustand": "^5.0.12",
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "babel-preset-expo": "~13.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "~19.0.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.0.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}