{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": true,
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../arkzen/core/components/**/*.ts",
    "../arkzen/core/components/**/*.tsx",
    "../arkzen/core/stores/**/*.ts",
    "../arkzen/core/native-bridge.ts"
  ],
}
