{
  "name": "arkzen-lynx",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rspeedy build",
    "sync:shared": "tsx arkzen/sync.ts",
    "dev": "npm run sync:shared && concurrently \"npm run arkzen\" \"NAPI_RS_NATIVE_LIBRARY_PATH=$(pwd)/node_modules/@rspack/binding-android-arm64/rspack.android-arm64.node rspeedy dev\"",
    "postinstall": "mkdir -p node_modules/@rspack/binding-android-arm64 && cp ~/rspack-src/target/aarch64-linux-android/release/librspack_node.so node_modules/@rspack/binding-android-arm64/rspack.android-arm64.node || true",
    "preview": "rspeedy preview",
    "arkzen": "tsx watch arkzen.ts",
    "arkzen:once": "tsx arkzen.ts"
  },
  "dependencies": {
    "@lynx-js/motion": "^0.0.3",
    "@lynx-js/react": "^0.121.1",
    "@sigx/lynx-icons": "^0.9.1",
    "@sigx/lynx-icons-lucide": "^0.9.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "zustand": "^4.5.4",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "^5.0.1",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.4.7",
    "@lynx-js/react-rsbuild-plugin": "^0.16.3",
    "@lynx-js/rspeedy": "^0.14.5",
    "@lynx-js/tailwind-preset": "^0.5.0",
    "@lynx-js/types": "3.7.0",
    "@rsbuild/plugin-type-check": "1.3.4",
    "@types/react": "^18.3.28",
    "chokidar": "^3.6.0",
    "concurrently": "^10.0.3",
    "rsbuild-plugin-tailwindcss": "^0.2.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}