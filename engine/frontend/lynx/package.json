{
  "name": "arkzen-lynx",
  "version": "1.0.0",
  "description": "Pluff — Lynx stack (Rspeedy / ReactLynx). Same tatemono DSL, Lynx mini-program output.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rspeedy build",
    "sync:shared": "tsx arkzen/sync.ts",
    "dev": "npm run sync:shared && concurrently \"npm run arkzen\" \"node arkzen/lynx-dev.js\"",
    "postinstall": "node arkzen/lynx-postinstall.js",
    "preview": "rspeedy preview",
    "arkzen": "tsx watch arkzen.ts",
    "arkzen:once": "tsx arkzen.ts"
  },
  "dependencies": {
    "@lynx-js/motion": "^0.0.6",
    "@lynx-js/react": "^0.127.0",
    "@lynx-js/web-elements": "^0.12.12",
    "@lucide/icons": "^1.53.0",
    "@sigx/lynx-icons": "^0.35.0",
    "@sigx/lynx-icons-fa-free": "^0.35.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "zustand": "^5.0.15",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "^5.0.1",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/react-rsbuild-plugin": "^0.20.3",
    "@lynx-js/rspeedy": "^0.18.0",
    "@lynx-js/tailwind-preset": "^0.6.0",
    "@lynx-js/types": "4.3.0",
    "@rsbuild/plugin-type-check": "1.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.6",
    "rsbuild-plugin-tailwindcss": "^0.2.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
