{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@/arkzen/generated/*": ["./src/arkzen/generated/*"],
      "@/arkzen/*": ["./arkzen/*"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist"
  },
  "include": ["arkzen.ts", "arkzen/**/*.ts", "src/**/*.tsx", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}