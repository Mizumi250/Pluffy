{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"] 
    },
    "outDir": "./dist"
  },
  "include": ["arkzen.ts", "arkzen/**/*.ts", "src/**/*.tsx", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}