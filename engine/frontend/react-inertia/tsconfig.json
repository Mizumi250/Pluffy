{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/arkzen/core/*": ["./arkzen/core/*"],
      "@/*": ["./resources/js/*"]
    },
    "outDir": "./dist"
  },
  "include": ["arkzen/**/*.ts", "resources/js/**/*.tsx", "resources/js/**/*.ts"],
  "exclude": ["node_modules"]
}
