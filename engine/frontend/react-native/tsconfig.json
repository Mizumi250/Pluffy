{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/arkzen/core/*": ["./arkzen/core/*"],
      "@/*": ["./src/*"]
    },
    "outDir": "./dist"
  },
  "include": ["arkzen/**/*.ts", "src/**/*.tsx", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
