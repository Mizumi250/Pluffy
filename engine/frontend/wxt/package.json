{
  "name": "arkzen-wxt-engine",
  "version": "1.0.0",
  "description": "Pluff - browser extension stack (WXT). Same tatemono DSL, Manifest V3 extension output.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:types": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "build:reference": "node scripts/build-reference.mjs",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  }
}
