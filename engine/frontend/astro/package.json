{
  "name": "arkzen-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:shared": "tsx arkzen/sync.ts",
    "arkzen": "tsx watch arkzen.ts",
    "dev": "npm run sync:shared && concurrently \"npm run arkzen\" \"astro dev --port 3000\"",
    "build": "npm run sync:shared && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.3.3",
    "axios": "^1.7.3",
    "framer-motion": "^11.3.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.400.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
