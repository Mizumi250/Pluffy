{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/arkzen/core/*": ["./arkzen/core/*"],
      "@/arkzen/generated/*": ["./src/arkzen/generated/*"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "arkzen"]
}
