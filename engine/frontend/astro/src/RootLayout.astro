---
interface Props {
  title?: string
}
const { title = 'Arkzen' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>@import "/src/styles/globals.css"</style>
  </head>
  <body>
    <div id="arkzen-root">
      <slot />
    </div>
  </body>
</html>