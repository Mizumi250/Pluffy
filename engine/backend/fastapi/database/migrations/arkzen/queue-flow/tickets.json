{
  "table": "tickets",
  "timestamps": true,
  "softDeletes": false,
  "columns": {
    "id": {
      "type": "integer",
      "primary": true,
      "autoIncrement": true
    },
    "queue_id": {
      "type": "foreignId",
      "foreign": "queue_flow_queues.id",
      "nullable": false
    },
    "ticket_number": {
      "type": "string",
      "nullable": false
    },
    "customer_name": {
      "type": "string",
      "nullable": true
    },
    "status": {
      "type": "string",
      "default": "waiting"
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "called_at": {
      "type": "datetime",
      "nullable": true
    },
    "served_at": {
      "type": "datetime",
      "nullable": true
    }
  },
  "indexes": []
}