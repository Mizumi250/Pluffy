{
  "table": "vocab_cards",
  "timestamps": true,
  "softDeletes": false,
  "columns": {
    "id": {
      "type": "integer",
      "primary": true,
      "autoIncrement": true
    },
    "user_id": {
      "type": "integer",
      "nullable": false
    },
    "lang": {
      "type": "string",
      "length": 8,
      "nullable": false
    },
    "term": {
      "type": "string",
      "length": 255,
      "nullable": false
    },
    "meaning": {
      "type": "string",
      "length": 255,
      "nullable": false
    },
    "example": {
      "type": "text",
      "nullable": true
    },
    "source": {
      "type": "string",
      "length": 16,
      "default": "manual"
    },
    "ease": {
      "type": "float",
      "default": 2.5
    },
    "interval_days": {
      "type": "integer",
      "default": 0
    },
    "reps": {
      "type": "integer",
      "default": 0
    },
    "lapses": {
      "type": "integer",
      "default": 0
    },
    "due_date": {
      "type": "date",
      "nullable": true
    }
  },
  "indexes": []
}