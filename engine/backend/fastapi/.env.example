PORT=8000
APP_URL=http://localhost:8000
ARKZEN_ENGINE_SECRET=arkzen-engine-secret

# sqlite (default) or pgsql. Each tatemono gets its own isolated database.
ARKZEN_DB_DRIVER=sqlite
ARKZEN_DB_PREFIX=pluff
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pluff
DB_USERNAME=postgres
DB_PASSWORD=

# database (default, like Laravel) or sync (run jobs inline)
QUEUE_CONNECTION=database

# Gemini API (OpenAI-compatible endpoint) for the ollama-studio Tatemono.
# Set the secret in engine/backend/fastapi/.env; never put API keys in Tatemono/browser code.
PLUFF_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PLUFF_AI_MODEL=gemini-3.6-flash
PLUFF_AI_API_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com

# Realtime (Pusher protocol, Reverb compatible)
REVERB_APP_KEY=pluff-key
REVERB_APP_SECRET=pluff-secret
REVERB_PORT=8080

# smtp or log (default: log the mail instead of sending it)
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
