HOST=0.0.0.0
PORT=8000
ARKZEN_ENGINE_SECRET=arkzen-engine-secret
ARKZEN_MODULE_DIR=storage/arkzen-modules
ARKZEN_DATABASE_DIR=database/arkzen
# sqlite (default) or pgsql. Each tatemono gets its own isolated database.
ARKZEN_DB_DRIVER=sqlite
ARKZEN_DB_PREFIX=pluff
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
# disable | prefer (default) | require
DB_SSLMODE=prefer
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
REVERB_PORT=8080
REVERB_APP_KEY=arkzen-key
REVERB_APP_SECRET=arkzen-secret
